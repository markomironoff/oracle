/* ===========================================================
   Azure SQL HR Demo Schema
   - Schema: hr
   - Tables: Location, Department, Job, Employee, EmployeeSalary, LeaveRequest
   =========================================================== */

-- Create schema if not exists
IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'hr')
    EXEC('CREATE SCHEMA hr');
GO

/* -------------------------
   Drop existing objects
   ------------------------- */
IF OBJECT_ID('hr.LeaveRequest', 'U') IS NOT NULL DROP TABLE hr.LeaveRequest;
IF OBJECT_ID('hr.EmployeeSalary', 'U') IS NOT NULL DROP TABLE hr.EmployeeSalary;
IF OBJECT_ID('hr.Employee', 'U') IS NOT NULL DROP TABLE hr.Employee;
IF OBJECT_ID('hr.Department', 'U') IS NOT NULL DROP TABLE hr.Department;
IF OBJECT_ID('hr.Job', 'U') IS NOT NULL DROP TABLE hr.Job;
IF OBJECT_ID('hr.Location', 'U') IS NOT NULL DROP TABLE hr.Location;
GO

/* -------------------------
   Base/reference tables
   ------------------------- */

CREATE TABLE hr.Location
(
    LocationId       INT IDENTITY(1,1) NOT NULL CONSTRAINT PK_Location PRIMARY KEY,
    LocationCode     NVARCHAR(10) NOT NULL CONSTRAINT UQ_LocationCode UNIQUE,
    Country          NVARCHAR(100) NOT NULL,
    City             NVARCHAR(100) NOT NULL,
    AddressLine1     NVARCHAR(200) NULL,
    PostalCode       NVARCHAR(20) NULL,
    CreatedAt        DATETIME2(0) NOT NULL CONSTRAINT DF_Location_CreatedAt DEFAULT (SYSUTCDATETIME())
);
GO

CREATE TABLE hr.Department
(
    DepartmentId     INT IDENTITY(1,1) NOT NULL CONSTRAINT PK_Department PRIMARY KEY,
    DepartmentCode   NVARCHAR(20) NOT NULL CONSTRAINT UQ_DepartmentCode UNIQUE,
    DepartmentName   NVARCHAR(200) NOT NULL,
    LocationId       INT NOT NULL,
    CostCenter       NVARCHAR(30) NULL,
    IsActive         BIT NOT NULL CONSTRAINT DF_Department_IsActive DEFAULT (1),
    CreatedAt        DATETIME2(0) NOT NULL CONSTRAINT DF_Department_CreatedAt DEFAULT (SYSUTCDATETIME()),
    CONSTRAINT FK_Department_Location FOREIGN KEY (LocationId) REFERENCES hr.Location(LocationId)
);
GO

CREATE TABLE hr.Job
(
    JobId            INT IDENTITY(1,1) NOT NULL CONSTRAINT PK_Job PRIMARY KEY,
    JobCode          NVARCHAR(30) NOT NULL CONSTRAINT UQ_JobCode UNIQUE,
    JobTitle         NVARCHAR(200) NOT NULL,
    JobFamily        NVARCHAR(100) NULL,
    Grade            TINYINT NULL,
    MinSalary        DECIMAL(12,2) NULL,
    MaxSalary        DECIMAL(12,2) NULL,
    IsActive         BIT NOT NULL CONSTRAINT DF_Job_IsActive DEFAULT (1),
    CreatedAt        DATETIME2(0) NOT NULL CONSTRAINT DF_Job_CreatedAt DEFAULT (SYSUTCDATETIME()),
    CONSTRAINT CK_Job_SalaryRange CHECK (
        (MinSalary IS NULL AND MaxSalary IS NULL)
        OR (MinSalary IS NOT NULL AND MaxSalary IS NOT NULL AND MinSalary <= MaxSalary)
    )
);
GO

/* -------------------------
   Core entity tables
   ------------------------- */

CREATE TABLE hr.Employee
(
    EmployeeId       INT IDENTITY(1000,1) NOT NULL CONSTRAINT PK_Employee PRIMARY KEY,
    EmployeeNumber   NVARCHAR(20) NOT NULL CONSTRAINT UQ_EmployeeNumber UNIQUE,
    FirstName        NVARCHAR(100) NOT NULL,
    LastName         NVARCHAR(100) NOT NULL,
    Email            NVARCHAR(255) NOT NULL CONSTRAINT UQ_Employee_Email UNIQUE,
    Phone            NVARCHAR(50) NULL,
    DateOfBirth      DATE NULL,
    HireDate         DATE NOT NULL,
    EmploymentStatus NVARCHAR(20) NOT NULL CONSTRAINT DF_Employee_Status DEFAULT ('ACTIVE'),
    DepartmentId     INT NOT NULL,
    JobId            INT NOT NULL,
    ManagerEmployeeId INT NULL,
    LocationId       INT NOT NULL,
    TerminationDate  DATE NULL,
    CreatedAt        DATETIME2(0) NOT NULL CONSTRAINT DF_Employee_CreatedAt DEFAULT (SYSUTCDATETIME()),
    UpdatedAt        DATETIME2(0) NOT NULL CONSTRAINT DF_Employee_UpdatedAt DEFAULT (SYSUTCDATETIME()),

    CONSTRAINT FK_Employee_Department FOREIGN KEY (DepartmentId) REFERENCES hr.Department(DepartmentId),
    CONSTRAINT FK_Employee_Job        FOREIGN KEY (JobId) REFERENCES hr.Job(JobId),
    CONSTRAINT FK_Employee_Location   FOREIGN KEY (LocationId) REFERENCES hr.Location(LocationId),
    CONSTRAINT FK_Employee_Manager    FOREIGN KEY (ManagerEmployeeId) REFERENCES hr.Employee(EmployeeId),

    CONSTRAINT CK_Employee_Status CHECK (EmploymentStatus IN ('ACTIVE','LEAVE','TERMINATED')),
    CONSTRAINT CK_Employee_TerminationDate CHECK (
        (EmploymentStatus <> 'TERMINATED' AND TerminationDate IS NULL)
        OR (EmploymentStatus = 'TERMINATED' AND TerminationDate IS NOT NULL)
    )
);
GO

-- Salary history (SCD type-ish)
CREATE TABLE hr.EmployeeSalary
(
    EmployeeSalaryId BIGINT IDENTITY(1,1) NOT NULL CONSTRAINT PK_EmployeeSalary PRIMARY KEY,
    EmployeeId       INT NOT NULL,
    SalaryAmount     DECIMAL(12,2) NOT NULL,
    CurrencyCode     CHAR(3) NOT NULL CONSTRAINT DF_EmployeeSalary_Currency DEFAULT ('EUR'),
    EffectiveFrom    DATE NOT NULL,
    EffectiveTo      DATE NULL,
    ChangeReason     NVARCHAR(200) NULL,
    CreatedAt        DATETIME2(0) NOT NULL CONSTRAINT DF_EmployeeSalary_CreatedAt DEFAULT (SYSUTCDATETIME()),

    CONSTRAINT FK_EmployeeSalary_Employee FOREIGN KEY (EmployeeId) REFERENCES hr.Employee(EmployeeId),
    CONSTRAINT CK_EmployeeSalary_Amount CHECK (SalaryAmount > 0),
    CONSTRAINT CK_EmployeeSalary_Range CHECK (EffectiveTo IS NULL OR EffectiveTo >= EffectiveFrom)
);
GO

-- Leave requests
CREATE TABLE hr.LeaveRequest
(
    LeaveRequestId   BIGINT IDENTITY(1,1) NOT NULL CONSTRAINT PK_LeaveRequest PRIMARY KEY,
    EmployeeId       INT NOT NULL,
    LeaveType        NVARCHAR(30) NOT NULL,  -- ANNUAL, SICK, UNPAID, PARENTAL
    StartDate        DATE NOT NULL,
    EndDate          DATE NOT NULL,
    Status           NVARCHAR(20) NOT NULL CONSTRAINT DF_LeaveRequest_Status DEFAULT ('PENDING'),
    RequestedAt      DATETIME2(0) NOT NULL CONSTRAINT DF_LeaveRequest_RequestedAt DEFAULT (SYSUTCDATETIME()),
    ApprovedByEmployeeId INT NULL,
    ApprovedAt       DATETIME2(0) NULL,
    Comment          NVARCHAR(500) NULL,

    CONSTRAINT FK_LeaveRequest_Employee FOREIGN KEY (EmployeeId) REFERENCES hr.Employee(EmployeeId),
    CONSTRAINT FK_LeaveRequest_Approver FOREIGN KEY (ApprovedByEmployeeId) REFERENCES hr.Employee(EmployeeId),
    CONSTRAINT CK_LeaveRequest_DateRange CHECK (EndDate >= StartDate),
    CONSTRAINT CK_LeaveRequest_Status CHECK (Status IN ('PENDING','APPROVED','REJECTED','CANCELLED')),
    CONSTRAINT CK_LeaveRequest_Type CHECK (LeaveType IN ('ANNUAL','SICK','UNPAID','PARENTAL'))
);
GO

/* -------------------------
   Helpful indexes
   ------------------------- */

CREATE INDEX IX_Employee_DepartmentId ON hr.Employee(DepartmentId);
CREATE INDEX IX_Employee_ManagerId ON hr.Employee(ManagerEmployeeId);
CREATE INDEX IX_Salary_Employee_EffectiveFrom ON hr.EmployeeSalary(EmployeeId, EffectiveFrom DESC);
CREATE INDEX IX_Leave_Employee_StartDate ON hr.LeaveRequest(EmployeeId, StartDate DESC);
GO

